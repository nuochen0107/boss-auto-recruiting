# Required: Feishu custom app credentials.
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# OpenClaw/Boss resume output directory.
RESUME_DIR=/Users/apple/Downloads/boss-resumes

# Default mode: Boss local resume -> Hire attachment -> talent -> job application.
FEISHU_HIRE_UPLOAD_MODE=talent_application

# Required for talent_application mode.
# Reusing existing local resumes for a new position only requires updating this value.
# Get it from GET /open-apis/hire/v1/jobs or Feishu Hire job detail.
FEISHU_HIRE_JOB_ID=

# Recommended: create/use a "Boss直聘" resume source in Feishu Hire and put its ID here.
FEISHU_HIRE_RESUME_SOURCE_ID=

# Optional: also add created/reused talents to this Feishu Hire talent pool.
FEISHU_HIRE_TALENT_POOL_ID=

# Optional: add created talents to talent folders. Comma-separated IDs.
FEISHU_HIRE_FOLDER_ID_LIST=

# Optional: intended application city code. Comma-separated, usually one city for applications.
FEISHU_HIRE_PREFERRED_CITY_CODE=

# Default 1 = HR sourcing, 2 = candidate active delivery.
FEISHU_HIRE_DELIVERY_TYPE=1

# Optional: creator. 3 means system, 1 means employee.
FEISHU_HIRE_CREATOR_ACCOUNT_TYPE=3
FEISHU_HIRE_CREATOR_ID=

# Optional: create a public note on the talent/application after import.
# Requires hire:note.
FEISHU_HIRE_CREATE_NOTE=0
FEISHU_HIRE_NOTE_PRIVACY=2
FEISHU_HIRE_NOTE_PREFIX=来源：Boss直聘 / OpenClaw 自动收取附件简历

# Legacy website_attachment mode only.
FEISHU_HIRE_WEBSITE_ID=
FEISHU_HIRE_JOB_POST_ID=

# Optional for website_attachment mode.
FEISHU_HIRE_CHANNEL_ID=

# Optional: JSON array or JSONL file with candidate metadata.
# Records can be matched by "file", "filename", or "name".
FEISHU_HIRE_CANDIDATE_MANIFEST=

# Optional: upload state path.
# Use a fresh state file when you want to resubmit already-known local resumes to a new job.
FEISHU_HIRE_UPLOAD_STATE=/Users/apple/ai-worker/feishu-hire-uploader/state.json

# By default, duplicate inferred candidate names are skipped except for the newest file.
# Set to 1 only if you have a manifest with stable external_id values and truly need same-name uploads.
FEISHU_HIRE_ALLOW_DUPLICATE_NAMES=0
