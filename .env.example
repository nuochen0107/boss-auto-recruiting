# Copy this file to .env.local and fill one provider.
# Never commit .env.local or an API key.

# Recommended generic OpenAI-compatible configuration.
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# MiniMax Token/Coding Plan:
# LLM_PROVIDER=minimax
# LLM_API_KEY=sk-cp-your-key
# LLM_BASE_URL=https://api.minimaxi.com/v1
# LLM_MODEL=MiniMax-M2.7

# Alibaba Cloud Model Studio pay-as-you-go API:
# Do not use a Coding Plan key in this custom application.
# LLM_PROVIDER=dashscope
# LLM_API_KEY=sk-your-key
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# DeepSeek V4 Pro:
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-your-key
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-pro

# Optional local service configuration
# CDP_PROXY_URL=http://127.0.0.1:3456
# BOSS_DASHBOARD_PORT=8787
